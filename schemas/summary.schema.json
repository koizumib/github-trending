{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/koizumib/trending-digest/schemas/summary.schema.json",
  "title": "リポジトリの要約（data/repos/{owner}__{name}.json）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo", "summarized_at", "short", "what", "can_do", "how_to_use", "use_cases",
    "for_whom", "similar", "tech", "caveats", "sources", "confidence", "confidence_note"
  ],
  "properties": {
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "summarized_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "short": {"type": "string", "minLength": 10, "maxLength": 300},
    "what": {"type": "string", "minLength": 5, "maxLength": 200},
    "can_do": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 10},
    "how_to_use": {"type": "string"},
    "use_cases": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 8},
    "for_whom": {"type": "string"},
    "similar": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 6},
    "tech": {"type": "string"},
    "caveats": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "confidence": {"enum": ["high", "medium", "low"]},
    "confidence_note": {"type": "string"}
  },
  "if": {"properties": {"confidence": {"const": "low"}}},
  "then": {"properties": {"confidence_note": {"minLength": 1}}}
}
