{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/koizumib/github-trending/schemas/summary.schema.json",
  "title": "リポジトリの要約（data/repos/{owner}__{name}.json）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "summarized_at",
    "short",
    "what",
    "can_do",
    "how_to_use",
    "use_cases",
    "for_whom",
    "similar",
    "tech",
    "caveats",
    "tags",
    "sources",
    "confidence",
    "confidence_note"
  ],
  "properties": {
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "summarized_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "short": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "what": {
      "type": "string",
      "minLength": 5,
      "maxLength": 50
    },
    "can_do": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 10
    },
    "how_to_use": {
      "type": "string"
    },
    "use_cases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 8
    },
    "for_whom": {
      "type": "string"
    },
    "similar": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 6
    },
    "tech": {
      "type": "string"
    },
    "caveats": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "description": "分野。この一覧から1〜4個選ぶ。先頭が主な分野",
      "items": {
        "enum": [
          "AI エージェント",
          "LLM",
          "機械学習",
          "音声・画像・動画",
          "開発ツール",
          "CLI",
          "エディタ・IDE",
          "データベース",
          "データ処理",
          "インフラ・運用",
          "コンテナ・Kubernetes",
          "ネットワーク",
          "セキュリティ",
          "監視・可観測性",
          "Web",
          "デスクトップアプリ",
          "モバイル",
          "セルフホスト",
          "ライブラリ・SDK",
          "言語・ランタイム",
          "自動化・ワークフロー",
          "ドキュメント・知識管理",
          "学習資料",
          "ゲーム",
          "その他"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "confidence_note": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "confidence": {
        "const": "low"
      }
    }
  },
  "then": {
    "properties": {
      "confidence_note": {
        "minLength": 1
      }
    }
  }
}
